# Where the built app sends its API calls.
#
# Leave this unset in development: the app then calls /api, and the Vite
# dev server proxies that to the FastAPI service (see vite.config.ts).
# Set it for a production build, where the two are served from different
# origins and the browser talks to the API directly.
#
# VITE_API_URL=http://localhost:8000

# Which API the dev-server proxy forwards to. Defaults to localhost:8000.
# PORT6_API_URL=http://localhost:8000
