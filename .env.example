# ==============================================================
# Database
# ==============================================================

DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/port6


# ==============================================================
# Models
#
# Everything about which model to call lives here and nowhere else.
# Runtime tuning (chunk size, retrieval thresholds, summary limits,
# prompts) lives in the database and is changed through the API:
#   GET/PUT /settings   GET/PUT /prompts
#
# Switching a provider changes the vector dimension, so embeddings are
# written to a per-model Chroma collection. Changing EMBEDDINGS_PROVIDER
# or the embedding model means re-ingesting.
# ==============================================================

# openai | ollama
LLM_PROVIDER=ollama
EMBEDDINGS_PROVIDER=ollama

# Shared across providers
LLM_TEMPERATURE=0.0

# --- OpenAI (required only when a provider above is openai) ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ollama (local, no API key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ==============================================================
# API
# ==============================================================

# Origins allowed to call the API from a browser, comma separated.
PORT6_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
